# Kopieer dit bestand naar .env en vul je eigen waarden in.
# Discord Bot-token:
DISCORD_BOT_TOKEN=

# Kanaal-ID Alert:
DISCORD_CHANNEL_ID=

# --- Severity-gestuurde ping ---
# Vul per severity een Discord-ROL-ID in. Alleen ingevulde severities pingen; de rest blijft stil.
ROLE_INFO=
ROLE_LOW=
ROLE_MEDIUM=
ROLE_HIGH=
ROLE_CRITICAL=

SPOILER_MENTION=true
MENTION_EVERYONE=false

# --- Heartbeat (heartbeat.mjs) ---
HEARTBEAT_INTERVAL_MINUTES=60
HEARTBEAT_CHANNEL_ID=
#
# De heartbeat checkt de héle keten. Daarvoor moet de heartbeat-container OP het opensearch-net draaien.
# OpenSearch-health (self-signed cert wordt genegeerd):
# OPENSEARCH_URL=https://opensearch-node1:xxxx
# OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
# Relay-health die de heartbeat controleert:
# RELAY_HEALTH_URL=http://discord-relay:xxxx/health

# --- Relay (relay.mjs) ---
# VERPLICHT: sterk, geheim token dat elke POST /alert in de X-Auth-Token-header moet meesturen.
RELAY_AUTH_TOKEN=

RELAY_HOST=0.0.0.0
RELAY_PORT=xxxx